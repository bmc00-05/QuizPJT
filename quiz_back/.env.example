# quiz_back/.env.example
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# SECRET_KEY 발급:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- Database
# 상대경로는 슬래시 3개, 절대경로는 4개
#   sqlite:///db.sqlite3
#   postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------- CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- AI
# OpenAI 호환 엔드포인트면 어느 프로바이더든 사용 가능.
# 키가 비어있을시 앱은 데모 응답으로 축소 동작.
#
# AI_BASE_URL은 "버전 경로까지 포함한" 전체 base URL이다.
# 코드가 뒤에 /chat/completions 만 붙이므로 끝에 슬래시를 넣지 말 것.
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI : https://api.openai.com/v1
#   Groq   : https://api.groq.com/openai/v1
#
# 이 프로젝트는 Gemini 무료 티어를 기준으로 구성되어 있다.
#   키 발급 : https://aistudio.google.com  →  Get API key
#   결제(Billing)를 연결하지 않으면 무료 티어에 고정되어 과금이 발생하지 않는다.
#   모델명은 AI Studio에서 사용 가능한 값을 확인.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# 전역 일일 호출 상한. 초과 시 데모 응답으로 전환된다.
AI_DAILY_LIMIT=100
