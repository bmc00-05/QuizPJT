# quiz_front/.env.example
# 이 파일을 .env 로 복사해 사용한다.
#   cp .env.example .env
#
# ⚠️ VITE_ 접두사 변수는 빌드 시 번들에 그대로 포함되어 브라우저에서 노출된다.
#    API 키 등 비밀값을 넣지 말 것. URL 같은 공개 정보만 둔다.

# 백엔드 API base URL (/api/v1 까지 포함)
#   로컬  : http://127.0.0.1:8000/api/v1
#   배포  : /api/v1        ← Nginx 가 프론트와 API 를 같은 오리진으로 서빙
VITE_REST_API_URL=http://127.0.0.1:8000/api/v1
