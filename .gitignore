# ==============================================================
#  CatLog — .gitignore
# ==============================================================

# ---------------------------------------------- 환경변수 / 시크릿
.env
.env.*
!.env.example

# ------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/

# 가상환경
venv/
.venv/
env/
ENV/

# ------------------------------------------------------- Django
# SQLite 본체 + WAL 모드 사이드카 파일 (DR-1)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

media/
staticfiles/
*.log

# --------------------------------------------- 테스트 / 커버리지
.pytest_cache/
.coverage
htmlcov/
.tox/

# --------------------------------------------------- Node / Vite
node_modules/
dist/
dist-ssr/
coverage/
*.local
.eslintcache
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cypress / Vitest
cypress/videos/
cypress/screenshots/
__screenshots__/

# ------------------------------------------------ 개인 개발 문서 (로컬)
docs/

# ----------------------------------------------------------- IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------ OS
.DS_Store
Thumbs.db
desktop.ini
